{
  "id": "minimax-h3-ref2v-ctx-balanced-2k",
  "version": 1,
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 参考视频·链式续接 + 学习式放大（>2K）",
  "description": "MiniMax H3 参考视频·链式续接 + 学习式放大（>2K） · balanced 档。由 scripts/make-h3-variants.mjs 生成，请勿手改。 两阶段：首遍尺寸**不锁**（按画布比例推导，本档长边 1344）→ 潜空间放大 ×2 → 交付 = 首遍 ×2。16:9 首遍 1344×756 → 交付 2688×1512；9:16 首遍 756×1344 → 交付 1512×2688；1:1 首遍 1344×1344 → 交付 2688×2688（像素量为 16:9 的 1.78×，更重）。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_MODEL_REF",
      "label": "H3 参考 UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "env": "DSH_SVS_H3_CLIP",
      "label": "H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_fp16.safetensors",
      "env": "DSH_SVS_H3_VAE",
      "label": "H3 视频 VAE（int8_convrot 为可选加速件，经配置/assetOverrides 切换）"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "env": "DSH_SVS_H3_AUDIO_VAE",
      "label": "H3 音频 VAE"
    },
    "lora_8step": {
      "kind": "lora",
      "default": "minimax_h3_ref2v_turbo_8step_v1.0_768p_comfyui_bf16.safetensors",
      "env": "DSH_SVS_H3_LORA_8STEP",
      "label": "H3 8 步平衡档 LoRA（768p，shift 6/3）"
    },
    "latent_upscaler": {
      "kind": "other",
      "default": "minimax_h3_latent_upscaler_3d_conv_v1_bf16.safetensors",
      "env": "DSH_SVS_H3_LATENT_UPSCALER",
      "label": "H3 学习式 latent 放大器（3D）"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "MiniMaxH3SigmaShift",
