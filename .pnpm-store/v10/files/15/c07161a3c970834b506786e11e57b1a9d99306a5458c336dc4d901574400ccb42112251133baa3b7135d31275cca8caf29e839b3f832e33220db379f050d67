    },
    "23": {
      "class_type": "MiniMaxH3MotionContextTrim",
      "inputs": {
        "images": [
          "11b",
          0
        ],
        "trim_frames": [
          "21",
          1
        ],
        "audio": [
          "11c",
          0
        ],
        "fps": 24,
        "match_tail": true
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    },
    "6b": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "${seed + 2000000}"
      }
    },
    "9b": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 0.3
      }
    },
    "11b": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "17",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "11c": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "17",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    }
