    "refs": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "ref_images.ref_image_${i}"
      },
      "max": 8
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "13",
        "field": "filename_prefix"
      }
    },
    "context_length": {
      "inject": "scalar",
      "to": {
        "node": "21",
        "field": "context_length"
      },
      "default": "22"
    },
    "audio_context_length": {
      "inject": "scalar",
      "to": {
        "node": "21",
        "field": "audio_context_length"
      },
      "default": 24
    },
    "context_clip_index": {
      "inject": "scalar",
      "to": {
        "node": "20",
        "field": "clip_index"
      }
    },
    "save_clip_index": {
      "inject": "scalar",
      "to": {
        "node": "22",
        "field": "clip_index"
      }
    },
    "steps2": {
      "inject": "scalar",
      "to": {
        "node": "9b",
        "field": "steps"
      },
      "default": 6
    }
  },
  "modes": {
    "balanced": {
      "steps": 8,
      "longSide": 1344,
      "loras": [
        {
          "asset": "lora_8step",
          "strength": 1
        }
      ]
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32,
    "default": {
      "balanced": [
        1344,
        768
      ]
    }
  },
  "constraints": {
    "aspectRatios": [
      "16:9",
      "9:16",
      "1:1"
    ],
    "maxDurationFrames": 124,
    "supportsSubtitles": true
  },
  "chain": {
    "source": "clip-latent",
    "sampleExtra": 22,
    "lengthGrid": [
      17,
      5
    ]
  },
  "requiresNodes": [
    "MiniMaxH3MotionContext",
    "MiniMaxH3MotionContextLoadLatent",
    "MiniMaxH3MotionContextSaveLatent",
    "MiniMaxH3MotionContextTrim",
    "MinimaxH3LatentUpscaler3DRefineHandoff"
  ],
  "resolutionLock": {
    "scale": 2,
    "note": "两阶段放大：首遍尺寸**不锁**（按显式 width/height 或画布比例 × 档位长边推导），学习式 3D latent 放大器 ×2 推到首遍的 2 倍，再以低噪声（denoise 0.3）精修。交付尺寸 = 首遍 × 2（16:9 首遍 1344×768 → 交付 2688×1536）。链式续接：**链上流动的是首遍 latent**（node 22 存的是 node 10），放大在其之后 ⇒ 同族续接成立；一条链内**首遍尺寸必须一致**（跨比例续接不成立），交付尺寸可以不同。"
  },
  "group": "minimax-h3-ref2v-ctx-2k",
  "tier": "balanced",
  "capability": "video.reference2video",
  "estSeconds": 1200,
  "note": "链式续接 + 学习式 latent ×2 · **首遍 8 步非 PDD**（balanced 档「不加速」的本来配方：普通 BasicScheduler 出 sigma）· 二遍 denoise 0.3 走普通 6 步 · 交付 2688×1536 · 与 balanced-pdd-2k **只差首遍要不要 PDD 加速**，是 A/B 的对照臂 · **耗时推算，未实测** · **首遍不锁**：交付 = 首遍 ×2，随画布比例变（16:9 首遍 1344×768、9:16 首遍 768×1344），上面写的交付尺寸是 16:9 口径。9:16 像素量与 16:9 相同（耗时同量级）；**1:1 首遍 1344×1344、交付 2688×2688、像素量 1.78×**，estSeconds 未按比例修正；**1:1 显存余量小（实测峰值 ≈73/79 GiB），尽量压帧数**（高分辨率档的 1:1 未实测）",
  "priority": -60
}
