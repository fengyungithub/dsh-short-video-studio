{
  "id": "minimax-h3-ref2v-ctx-quality",
  "version": 1,
  "capability": "video.reference2video",
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 参考视频·链式续接",
  "description": "MiniMax H3 参考视频·链式续接 · quality 档。由 scripts/make-h3-variants.mjs 生成，请勿手改。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_MODEL_REF",
      "label": "H3 参考 UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "env": "DSH_SVS_H3_CLIP",
      "label": "H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_fp16.safetensors",
      "env": "DSH_SVS_H3_VAE",
      "label": "H3 视频 VAE"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "env": "DSH_SVS_H3_AUDIO_VAE",
      "label": "H3 音频 VAE"
    },
    "fast_lora": {
      "kind": "lora",
      "default": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
      "env": "DSH_SVS_H3_LORA_FAST",
      "label": "H3 fast LoRA"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "model": [
          "$model",
          0
        ],
        "shift_video": 12,
        "shift_audio": 3
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "minimax"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "5": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "audio_vae": [
          "4a",
          0
        ],
        "prompt": null,
        "width": null,
        "height": null,
        "length": null,
        "ref_image_size": "match"
      }
    },
    "6": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": null
      }
    },
    "7": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "conditioning": [
          "21",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      }
    },
    "9": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 1
      }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9",
          0
        ],
        "latent_image": [
          "5",
          1
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "12": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "23",
          0
        ],
        "audio": [
          "23",
          1
        ],
        "fps": null
      }
    },
    "13": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "12",
          0
        ],
        "filename_prefix": null,
        "format": "mp4",
        "codec": "h264"
      }
    },
    "20": {
      "class_type": "MiniMaxH3MotionContextLoadLatent",
      "inputs": {
        "latent_path": "h3_context",
        "clip_index": null
      }
    },
    "21": {
      "class_type": "MiniMaxH3MotionContext",
      "inputs": {
        "conditioning": [
          "5",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "latent": [
          "5",
          1
        ],
        "context_length": "22",
        "audio_context_length": 24,
        "context_latent": [
          "20",
          0
        ]
      }
    },
    "22": {
      "class_type": "MiniMaxH3MotionContextSaveLatent",
      "inputs": {
        "latent": [
          "10",
          0
        ],
        "filename_prefix": "h3_context/clip",
        "clip_index": null
      }
    },
    "23": {
      "class_type": "MiniMaxH3MotionContextTrim",
      "inputs": {
        "images": [
          "11",
          0
        ],
        "trim_frames": [
          "21",
          1
        ],
        "audio": [
          "11a",
          0
        ],
        "fps": 24,
        "match_tail": true
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "prompt"
      }
    },
    "width": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "width"
      }
    },
    "height": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "height"
      }
    },
    "length": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "length"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "noise_seed"
      }
    },
    "steps": {
      "inject": "scalar",
      "to": {
        "node": "9",
        "field": "steps"
      }
    },
    "fps": {
      "inject": "scalar",
      "to": {
        "node": "12",
        "field": "fps"
      },
      "default": 24
    },
    "refs": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "ref_images.ref_image_${i}"
      },
      "max": 8
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "13",
        "field": "filename_prefix"
      }
    },
    "context_length": {
      "inject": "scalar",
      "to": {
        "node": "21",
        "field": "context_length"
      },
      "default": "22"
    },
    "audio_context_length": {
      "inject": "scalar",
      "to": {
        "node": "21",
        "field": "audio_context_length"
      },
      "default": 24
    },
    "context_clip_index": {
      "inject": "scalar",
      "to": {
        "node": "20",
        "field": "clip_index"
      }
    },
    "save_clip_index": {
      "inject": "scalar",
      "to": {
        "node": "22",
        "field": "clip_index"
      }
    }
  },
  "modes": {
    "quality": {
      "steps": 20,
      "longSide": 1344,
      "loras": []
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32,
    "default": {
      "fast": [
        832,
        480
      ],
      "quality": [
        1344,
        768
      ]
    }
  },
  "constraints": {
    "aspectRatios": [
      "16:9",
      "9:16",
      "1:1"
    ],
    "maxDurationFrames": 288,
    "supportsSubtitles": true
  },
  "chain": {
    "source": "clip-latent",
    "sampleExtra": 22,
    "lengthGrid": [
      17,
      5
    ]
  },
  "requiresNodes": [
    "MiniMaxH3MotionContext",
    "MiniMaxH3MotionContextLoadLatent",
    "MiniMaxH3MotionContextSaveLatent",
    "MiniMaxH3MotionContextTrim"
  ],
  "group": "minimax-h3-ref2v-ctx",
  "tier": "quality",
  "estSeconds": 400,
  "note": "链式续接 · 20 步 · 采样多 22 帧后裁掉",
  "priority": -100
}
