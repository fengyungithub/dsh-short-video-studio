{
  "id": "minimax-h3-i2v-hires",
  "version": 1,
  "capability": "video.image2video",
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 首末帧生成视频·两阶段放大",
  "description": "MiniMax H3 首末帧生成视频·两阶段放大 · quality 档。由 scripts/make-h3-variants.mjs 生成，请勿手改。 两阶段：首遍 896×512（图分辨率锁定，显式 width/height 不生效）→ 潜空间放大 ×1.5 → 交付约 1344×768。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_MODEL_FL",
      "label": "H3 FL2VA UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "env": "DSH_SVS_H3_CLIP",
      "label": "H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_fp16.safetensors",
      "env": "DSH_SVS_H3_VAE",
      "label": "H3 视频 VAE（int8_convrot 为可选加速件，经配置/assetOverrides 切换）"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "env": "DSH_SVS_H3_AUDIO_VAE",
      "label": "H3 音频 VAE"
    },
    "fast_lora": {
      "kind": "lora",
      "default": "minimax_h3_fl2v_lightx2v_turbo_4step_v0.1_comfy.safetensors",
      "env": "DSH_SVS_H3_LORA_FL_FAST",
      "label": "H3 fl2v fast LoRA（544p，shift 12/3）"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "model": [
          "$model",
          0
        ],
        "shift_video": 12,
        "shift_audio": 3
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "minimax"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "5": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "prompt": null,
        "width": null,
        "height": null,
        "length": null
      }
    },
    "6": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": null
      }
    },
    "7": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "conditioning": [
          "5",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      }
    },
    "9": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 1
      }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9",
          0
        ],
        "latent_image": [
          "5",
          1
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "12": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "11b",
          0
        ],
        "audio": [
          "11c",
          0
        ],
        "fps": null
      }
    },
    "13": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "12",
          0
        ],
        "filename_prefix": null,
        "format": "mp4",
        "codec": "h264"
      }
    },
    "14": {
      "class_type": "MiniMaxH3AVLatentUpscaleBy",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "upscale_method": "bislerp",
        "scale_by": 1.5
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    },
    "6b": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "${seed + 1000000}"
      }
    },
    "9b": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 0.35
      }
    },
    "10b": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6b",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9b",
          0
        ],
        "latent_image": [
          "14",
          0
        ]
      }
    },
    "11b": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10b",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "11c": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10b",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "prompt"
      }
    },
    "width": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "width"
      }
    },
    "height": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "height"
      }
    },
    "length": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "length"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "noise_seed"
      }
    },
    "steps": {
      "inject": "scalar",
      "to": {
        "node": "9",
        "field": "steps"
      }
    },
    "fps": {
      "inject": "scalar",
      "to": {
        "node": "12",
        "field": "fps"
      },
      "default": 24
    },
    "first_frame": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "first_frame"
      },
      "preprocess": [
        {
          "class_type": "ImageScale",
          "inputs": {
            "upscale_method": "lanczos",
            "width": "${width}",
            "height": "${height}",
            "crop": "disabled"
          }
        }
      ]
    },
    "last_frame": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "last_frame"
      },
      "preprocess": [
        {
          "class_type": "ImageScale",
          "inputs": {
            "upscale_method": "lanczos",
            "width": "${width}",
            "height": "${height}",
            "crop": "disabled"
          }
        }
      ]
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "13",
        "field": "filename_prefix"
      }
    },
    "steps2": {
      "inject": "scalar",
      "to": {
        "node": "9b",
        "field": "steps"
      },
      "default": 6
    }
  },
  "modes": {
    "quality": {
      "steps": 20,
      "longSide": 1344,
      "loras": []
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32,
    "default": {
      "quality": [
        896,
        512
      ]
    }
  },
  "constraints": {
    "aspectRatios": [
      "16:9"
    ],
    "maxDurationFrames": 310,
    "supportsSubtitles": true
  },
  "resolutionLock": {
    "graph": [
      896,
      512
    ],
    "scale": 1.5,
    "note": "首遍 896×512 是模型原生 1344×768 的 1/1.5，放大 1.5× 正好落在原生分辨率上——二遍在模型最擅长重建的尺寸上细化，而不是在它没见过的尺寸上重画"
  },
  "requiresNodes": [
    "MiniMaxH3AVLatentUpscaleBy"
  ],
  "group": "minimax-h3-i2v-hires",
  "tier": "quality",
  "estSeconds": 480,
  "note": "两阶段放大 · 首遍 896×512 20 步 → latent ×1.5 → 二遍 denoise 0.35 · 交付 1344×768 · 耗时待实测",
  "priority": -50
}
