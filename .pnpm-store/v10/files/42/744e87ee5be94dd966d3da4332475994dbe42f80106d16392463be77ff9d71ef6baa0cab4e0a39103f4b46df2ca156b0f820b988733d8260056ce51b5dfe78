{
  "id": "minimax-h3-ref2v-hires",
  "version": 1,
  "capability": "video.reference2video",
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 参考绑定视频（带声音）",
  "description": "MiniMax H3 两阶段潜空间放大：首遍在模型原生 768p 上解运动/构图/声音，再把视频 latent 放大 1.5×，二遍以低噪声（denoise 0.35）在同一模型上重建细节。开源版 H3 原生上限即 768p（1344×768），超过该尺寸直接采样会出复制/克隆伪影，所以「提分辨率」只能靠二遍。音频 latent 全程不被放大、二遍噪声为 0，音轨与口型沿用首遍。注意：图分辨率被 resolutionLock 锁死，显式 width/height 与画布比例均不生效。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_MODEL_REF",
      "label": "H3 参考 UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "env": "DSH_SVS_H3_CLIP",
      "label": "H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_fp16.safetensors",
      "env": "DSH_SVS_H3_VAE",
      "label": "H3 视频 VAE"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "env": "DSH_SVS_H3_AUDIO_VAE",
      "label": "H3 音频 VAE"
    },
    "fast_lora": {
      "kind": "lora",
      "default": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
      "env": "DSH_SVS_H3_LORA_FAST",
      "label": "H3 fast LoRA"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "model": [
          "$model",
          0
        ],
        "shift_video": 12,
        "shift_audio": 3
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "minimax"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "5": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "audio_vae": [
          "4a",
          0
        ],
        "prompt": null,
        "width": null,
        "height": null,
        "length": null,
        "ref_image_size": "match"
      }
    },
    "6": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": null
      }
    },
    "7": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "conditioning": [
          "5",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      }
    },
    "9": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 1
      }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9",
          0
        ],
        "latent_image": [
          "5",
          1
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "12": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "11b",
          0
        ],
        "audio": [
          "11c",
          0
        ],
        "fps": null
      }
    },
    "13": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "12",
          0
        ],
        "filename_prefix": null,
        "format": "mp4",
        "codec": "h264"
      }
    },
    "14": {
      "class_type": "MiniMaxH3AVLatentUpscaleBy",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "upscale_method": "bislerp",
        "scale_by": 1.5
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    },
    "6b": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "${seed + 1000000}"
      }
    },
    "9b": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 0.35
      }
    },
    "10b": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6b",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9b",
          0
        ],
        "latent_image": [
          "14",
          0
        ]
      }
    },
    "11b": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10b",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "11c": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10b",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "prompt"
      }
    },
    "width": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "width"
      }
    },
    "height": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "height"
      }
    },
    "length": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "length"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "noise_seed"
      }
    },
    "steps": {
      "inject": "scalar",
      "to": {
        "node": "9",
        "field": "steps"
      }
    },
    "fps": {
      "inject": "scalar",
      "to": {
        "node": "12",
        "field": "fps"
      },
      "default": 24
    },
    "refs": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "ref_images.ref_image_${i}"
      },
      "max": 8
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "13",
        "field": "filename_prefix"
      }
    },
    "steps2": {
      "inject": "scalar",
      "to": {
        "node": "9b",
        "field": "steps"
      },
      "default": 6
    }
  },
  "modes": {
    "quality": {
      "steps": 20,
      "longSide": 1344,
      "loras": []
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32,
    "default": {
      "quality": [
        896,
        512
      ]
    }
  },
  "constraints": {
    "aspectRatios": [
      "16:9"
    ],
    "maxDurationFrames": 310,
    "supportsSubtitles": true
  },
  "resolutionLock": {
    "graph": [
      896,
      512
    ],
    "scale": 1.5,
    "note": "首遍 896×512 是模型原生 1344×768 的 1/1.5，放大 1.5× 正好落在原生分辨率上——二遍在模型最擅长重建的尺寸上细化，而不是在它没见过的尺寸上重画"
  },
  "requiresNodes": [
    "MiniMaxH3AVLatentUpscaleBy"
  ]
}
