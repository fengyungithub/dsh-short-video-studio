{
  "id": "minimax-h3-ref2v-ctx-quality-2k",
  "version": 1,
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 参考绑定视频（带声音）",
  "description": "链式续接 + 学习式放大（U1）：在 `minimax-h3-ref2v-ctx-quality` 的同一份图上，把采样结果交给**学习式 3D latent 放大器**（在同一模型上精修出细节），交付 = 首遍 × 2。与 hires 档的区别：hires 用的是**插值**放大，只能把低分辨率首遍拉回原生 768p（交付仍是 768p）；本档用学习式放大器，在 latent 空间真重建，因此交付分辨率**超过原生上限**。音频 latent 全程不被放大、精修时被 mask 在外（lock_audio），音轨与口型沿用首遍。**首遍尺寸不锁**（`resolutionLock` 只声明倍率），按显式 width/height 或画布比例推导；图内目标尺寸是算术模板（`${width * 2}`），跟着首遍走 ⇒ **支持 16:9 / 9:16 / 1:1**：16:9 首遍 1344×768 → 交付 2688×1536；9:16 首遍 768×1344 → 交付 1536×2688（像素量相同）；1:1 首遍 1344×1344 → 交付 2688×2688（像素量为 16:9 的 1.75×，更重、可能 OOM）。**链式续接与两阶段放大可叠用**：链上传递的是首遍 latent（node 22 读 node 10），放大在其之后；同一条链内首遍尺寸必须一致（跨比例不能续接）。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_MODEL_REF",
      "label": "H3 参考 UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "env": "DSH_SVS_H3_CLIP",
      "label": "H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_fp16.safetensors",
      "env": "DSH_SVS_H3_VAE",
      "label": "H3 视频 VAE"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "env": "DSH_SVS_H3_AUDIO_VAE",
      "label": "H3 音频 VAE"
    },
    "fast_lora": {
      "kind": "lora",
      "default": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
      "env": "DSH_SVS_H3_LORA_FAST",
      "label": "H3 fast LoRA"
    },
    "latent_upscaler": {
      "kind": "other",
      "default": "minimax_h3_latent_upscaler_3d_conv_v1_bf16.safetensors",
      "env": "DSH_SVS_H3_LATENT_UPSCALER",
      "label": "H3 学习式 latent 放大器（3D）"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "model": [
          "$model",
          0
        ],
        "shift_video": 12,
        "shift_audio": 3
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "minimax"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "5": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "audio_vae": [
          "4a",
          0
        ],
        "prompt": null,
        "width": null,
        "height": null,
        "length": null,
        "ref_image_size": "match"
      }
    },
    "6": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": null
      }
    },
    "7": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "conditioning": [
          "21",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      }
    },
    "9": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 1
      }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9",
          0
        ],
        "latent_image": [
          "5",
          1
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "12": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "23",
          0
        ],
        "audio": [
          "23",
          1
        ],
        "fps": null
      }
    },
    "13": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "12",
          0
        ],
        "filename_prefix": null,
        "format": "mp4",
        "codec": "h264"
      }
    },
    "17": {
      "class_type": "MinimaxH3LatentUpscaler3DRefineHandoff",
      "inputs": {
        "latent": [
          "10",
          0
        ],
        "noise": [
          "6b",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9b",
          0
        ],
        "model": [
          "2",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "model_name": "$assets.latent_upscaler",
        "mode": "target dimensions",
        "width": "${width * 2}",
        "height": "${height * 2}",
        "scale": 2,
        "megapixels": 1,
        "align": 32,
        "keep_proportion": true,
        "lock_audio": true,
        "cfg": 1,
        "device": "cuda",
        "precision": "bf16",
        "offload_after_upscale": true
      }
    },
    "20": {
      "class_type": "MiniMaxH3MotionContextLoadLatent",
      "inputs": {
        "latent_path": "h3_context",
        "clip_index": null
      }
    },
    "21": {
      "class_type": "MiniMaxH3MotionContext",
      "inputs": {
        "conditioning": [
          "5",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "latent": [
          "5",
          1
        ],
        "context_length": "22",
        "audio_context_length": 24,
        "context_latent": [
          "20",
          0
        ]
      }
    },
    "22": {
      "class_type": "MiniMaxH3MotionContextSaveLatent",
      "inputs": {
        "latent": [
          "10",
          0
        ],
        "filename_prefix": "h3_context/clip",
        "clip_index": null
      }
    },
    "23": {
      "class_type": "MiniMaxH3MotionContextTrim",
      "inputs": {
        "images": [
          "11b",
          0
        ],
        "trim_frames": [
          "21",
          1
        ],
        "audio": [
          "11c",
          0
        ],
        "fps": 24,
        "match_tail": true
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    },
    "6b": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "${seed + 2000000}"
      }
    },
    "9b": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 0.3
      }
    },
    "11b": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "17",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "11c": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "17",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
