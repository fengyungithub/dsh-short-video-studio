{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh.local/schemas/episode-package.schema.json",
  "title": "Episode Package (contract v1)",
  "description": "集制作包的机器可读块（contract v1）。放在 package.md 与画布节点最上方的 fenced json 块；六节人类可读内容照旧。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "episode",
    "targetSeconds",
    "shotBudget",
    "paywall",
    "hookType",
    "scenes",
    "dialogue",
    "shots",
    "assets",
    "params"
  ],
  "properties": {
    "contract": {
      "const": "episode-package/v1"
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "id",
        "title",
        "sourceScript"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^EP[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceScript": {
          "type": "string",
          "minLength": 1
        },
        "sourceDialogueCount": {
          "type": "integer",
          "minimum": 0,
          "description": "源剧本对白句数（可大于 dialogue 行数：同说话人连说会合并）"
        }
      }
    },
    "targetSeconds": {
      "type": "number",
      "minimum": 60,
      "maximum": 180
    },
    "shotBudget": {
      "type": "integer",
      "minimum": 4,
      "maximum": 40
    },
    "paywall": {
      "type": "boolean"
    },
    "hookType": {
      "type": "string",
      "enum": [
        "setup",
        "visual-joke",
        "reversal",
        "reveal",
        "callback",
        "suspense",
        "tender",
        "chase",
        "expression-beat",
        "climax"
      ]
    },
    "prevRecap": {
      "type": "string"
    },
    "nextTeaser": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intExt",
          "location",
          "dayNight",
          "cast",
          "event",
          "escalation",
          "landmarks",
          "lightBaseline"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SC[0-9]{2}$"
          },
          "intExt": {
            "type": "string",
            "enum": [
              "内",
              "外",
              "内外"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "dayNight": {
            "type": "string",
            "enum": [
              "日",
              "夜",
              "晨",
              "昏"
            ]
          },
          "cast": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "escalation": {
            "type": "string",
            "minLength": 1
          },
          "landmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "position"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "position": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "lightBaseline": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "no",
          "speaker",
          "text",
          "emotion",
          "targetSeconds",
          "subtitle",
          "voiceRef"
        ],
        "properties": {
          "no": {
            "type": "integer",
            "minimum": 1
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "emotion": {
            "type": "string"
          },
          "targetSeconds": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 15
          },
          "subtitle": {
            "type": "string"
          },
          "voiceRef": {
            "type": "string",
            "pattern": "^(voice:[A-Za-z0-9:_-]+|canvas:[A-Za-z0-9-]+|none)$",
            "description": "voice:<资产id> / canvas:<画布音频节点id> / none"
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shotId",
          "seconds",
          "sceneId",
          "speaker",
          "line",
          "performance",
          "shotSizeCamera",
          "screenPositions",
          "chainIntent",
          "beat"
        ],
        "properties": {
          "shotId": {
            "type": "string",
            "pattern": "^S[0-9]{2,3}$"
          },
          "seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 15
          },
          "sceneId": {
            "type": "string",
            "pattern": "^(SC[0-9]{2}|TRANSITION)$",
            "description": "关联场次；跨场景转场镜写 TRANSITION"
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "string",
              "null"
            ]
          },
          "performance": {
            "type": "string",
            "minLength": 1
          },
          "shotSizeCamera": {
            "type": "string",
            "minLength": 1
          },
          "screenPositions": {
            "type": "string",
            "minLength": 1
          },
          "chainIntent": {
            "type": "string",
            "pattern": "^(起链|接 S[0-9]{2,3}|转场|硬切)$",
            "description": "起链=场景首镜；接 Sxx=同场景续接；转场=跨场景转场镜；硬切=同场景刻意硬切（需在连续性衔接写明理由）"
          },
          "beat": {
            "type": "string",
            "minLength": 1,
            "description": "集内节拍（建议：钩子/爽点-打脸/爽点-护/反转/揭露/情绪点/甜/危机/💰卡点/转场）"
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "scenes",
        "props",
        "voices",
        "toBuild"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "state",
              "episodes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "singleNodeId": {
                "type": "string"
              },
              "threeNodeId": {
                "type": "string"
              },
              "assetId": {
                "type": "string"
              },
              "episodes": {
                "type": "string"
              },
              "assetIdSingle": {
                "type": "string",
                "description": "单视图资产 id（library 模式必填；空=TO-BUILD）"
              },
              "assetIdThree": {
                "type": "string",
                "description": "三视图资产 id（library 模式建议填；空=缺该版本）"
              }
            }
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "assetId",
              "landmarks",
              "lightBaseline"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "assetId": {
                "type": "string"
              },
              "landmarks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "position"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "position": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "lightBaseline": {
                "type": "string"
              },
              "nodeId": {
                "type": "string",
                "description": "画布节点 id（未入库时用它复用）"
              }
            }
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "assetId",
              "episodes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "assetId": {
                "type": "string"
              },
              "episodes": {
                "type": "string"
              },
              "nodeId": {
                "type": "string",
                "description": "画布节点 id（未入库时用它复用）"
              }
            }
          }
        },
        "voices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "character",
              "voiceAssetId",
              "source",
              "tier",
              "seed",
              "episodes"
            ],
            "properties": {
              "character": {
                "type": "string"
              },
              "voiceAssetId": {
                "type": "string",
                "pattern": "^(voice:[A-Za-z0-9:_-]+|none|)$",
                "description": "入库后的 voice:<id>；未入库可留空并用 canvasNodeId"
              },
              "source": {
                "type": "string",
                "enum": [
                  "audition",
                  "existing",
                  "text-only"
                ]
              },
              "auditionNodeId": {
                "type": "string"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "fast",
                  "balanced",
                  "quality"
                ]
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              },
              "episodes": {
                "type": "string"
              },
              "canvasNodeId": {
                "type": "string",
                "description": "未入库时的画布音频节点 id（仅同会话可用）"
              }
            }
          }
        },
        "toBuild": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "description": "本集缺卡清单；量产期 ≤2，建卡集（EP01/新角色）≤8"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "styleId",
        "aspectRatio",
        "duration",
        "audioMode",
        "subtitleMode",
        "videoTier",
        "imageTier",
        "characterCardVariant",
        "deliveryQuality",
        "reviewMode",
        "voicePlan",
        "storyboardMode",
        "groupOrderVersion",
        "assetMode"
      ],
      "properties": {
        "styleId": {
          "type": "string",
          "enum": [
            "pixar-3d",
            "cinematic-live-action",
            "ghibli-2d",
            "anime-cel",
            "ink-wash-oriental",
            "comic-halftone",
            "guofeng-xianxia"
          ]
        },
        "aspectRatio": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$"
        },
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "audioMode": {
          "type": "string",
          "enum": [
            "dialogue-led",
            "silent"
          ]
        },
        "subtitleMode": {
          "type": "string",
          "enum": [
            "burned-in",
            "none"
          ]
        },
        "videoTier": {
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "quality"
          ]
        },
        "imageTier": {
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "quality"
          ]
        },
        "characterCardVariant": {
          "type": "string",
          "enum": [
            "single",
            "three"
          ]
        },
        "deliveryQuality": {
          "type": "string",
          "enum": [
            "native",
            "upscale1080",
            "upscale2k",
            "upscale4k"
          ]
        },
        "reviewMode": {
          "type": "string",
          "enum": [
            "per-shot",
            "batch"
          ]
        },
        "voicePlan": {
          "type": "string",
          "enum": [
            "audition",
            "existing",
            "text-only"
          ]
        },
        "storyboardMode": {
          "type": "string",
          "enum": [
            "text",
            "text+pencil"
          ]
        },
        "groupOrderVersion": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "assetMode": {
          "type": "string",
          "enum": [
            "draft",
            "library"
          ],
          "description": "draft=允许画布节点/canvas 声线临时引用（EP01/试产）；library=量产，必须有资产 id"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimatedMinutes",
        "shotCount",
        "dialogueCount"
      ],
      "properties": {
        "estimatedMinutes": {
          "type": "number",
          "minimum": 0
        },
        "shotCount": {
          "type": "integer",
          "minimum": 1
        },
        "dialogueCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageApprovedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
