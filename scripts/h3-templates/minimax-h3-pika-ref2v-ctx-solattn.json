{
  "id": "minimax-h3-pika-ref2v-ctx-solattn",
  "version": 1,
  "capability": "video.reference2video",
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 参考绑定 · Pika H3 Flex 6 步 · 链式续接 + 原生块稀疏",
  "description": "Pika H3 Flex（MiniMax H3 后训练 6 步蒸馏）· lcm + 固定 ManualSigmas + LoRA strength 1.0。★不要接 MiniMaxH3SigmaShift（sigma 已含 shift）、不要叠 turbo/Lightning LoRA。1344×768 训练域，原生音视频。★链式续接：消费上一镜服务端 latent，采样多 22 帧后裁掉。★原生 BlockSparseAttention（sol-attn, tau 1.0），非第三方 SolAttn。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_MODEL_REF",
      "label": "H3 参考 UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "env": "DSH_SVS_H3_CLIP",
      "label": "H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_VAE",
      "label": "H3 视频 VAE（int8_convrot，Pika 官方模板配对）"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "env": "DSH_SVS_H3_AUDIO_VAE",
      "label": "H3 音频 VAE"
    },
    "lora_pika": {
      "kind": "lora",
      "default": "pika_h3_flex_ref2va_v1_bf16.safetensors",
      "env": "DSH_SVS_H3_LORA_PIKA",
      "label": "Pika H3 Flex 6 步适配器（ref2va, bf16, strength 1.0）"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "minimax"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "5": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "audio_vae": [
          "4a",
          0
        ],
        "prompt": null,
        "width": null,
        "height": null,
        "length": null,
        "ref_image_size": "match"
      }
    },
    "6": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": null
      }
    },
    "7": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "2b",
          0
        ],
        "conditioning": [
          "21",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "lcm"
      }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "14",
          0
        ],
        "latent_image": [
          "5",
          1
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    },
    "12": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "23",
          0
        ],
        "audio": [
          "23",
          1
        ],
        "fps": null
      }
    },
    "13": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "12",
          0
        ],
        "filename_prefix": null,
        "format": "mp4",
        "codec": "h264"
      }
    },
    "14": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "1.0, 0.972973, 0.923077, 0.8, 0.571429, 0.333333, 0.0"
      }
    },
    "20": {
      "class_type": "MiniMaxH3MotionContextLoadLatent",
      "inputs": {
        "latent_path": "h3_context",
        "clip_index": null
      }
    },
    "21": {
      "class_type": "MiniMaxH3MotionContext",
      "inputs": {
        "conditioning": [
          "5",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "latent": [
          "5",
          1
        ],
        "context_length": "22",
        "audio_context_length": 24,
        "context_latent": [
          "20",
          0
        ]
      }
    },
    "22": {
      "class_type": "MiniMaxH3MotionContextSaveLatent",
      "inputs": {
        "latent": [
          "10",
          0
        ],
        "filename_prefix": "h3_context/clip",
        "clip_index": null
      }
    },
    "23": {
      "class_type": "MiniMaxH3MotionContextTrim",
      "inputs": {
        "images": [
          "11",
          0
        ],
        "trim_frames": [
          "21",
          1
        ],
        "audio": [
          "11a",
          0
        ],
        "fps": 24,
        "match_tail": true
      }
    },
    "2b": {
      "class_type": "BlockSparseAttention",
      "inputs": {
        "model": [
          "$model",
          0
        ],
        "selection": "sol-attn",
        "selection.tau": 1.0,
        "start_percent": 0.2,
        "end_percent": 1,
        "dense_blocks": "",
        "min_tokens": 12288,
        "extra_tokens": 256,
        "sink_conditioning": "exact_kv_and_rows",
        "verbose": true
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "prompt"
      }
    },
    "width": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "width"
      }
    },
    "height": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "height"
      }
    },
    "length": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "length"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "noise_seed"
      }
    },
    "fps": {
      "inject": "scalar",
      "to": {
        "node": "12",
        "field": "fps"
      },
      "default": 24
    },
    "refs": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "ref_images.ref_image_${i}"
      },
      "max": 8
    },
    "ref_audios": {
      "inject": "audio",
      "via": "node",
      "node": "LoadAudio",
      "input": "audio",
      "to": {
        "node": "5",
        "field": "ref_audios.ref_audio_${i}"
      },
      "max": 3
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "13",
        "field": "filename_prefix"
      }
    },
    "context_length": {
      "inject": "scalar",
      "to": {
        "node": "21",
        "field": "context_length"
      },
      "default": "22"
    },
    "audio_context_length": {
      "inject": "scalar",
      "to": {
        "node": "21",
        "field": "audio_context_length"
      },
      "default": 24
    },
    "context_clip_index": {
      "inject": "scalar",
      "to": {
        "node": "20",
        "field": "clip_index"
      }
    },
    "save_clip_index": {
      "inject": "scalar",
      "to": {
        "node": "22",
        "field": "clip_index"
      }
    }
  },
  "modes": {
    "balanced": {
      "steps": 6,
      "longSide": 1344,
      "loras": [
        {
          "asset": "lora_pika",
          "strength": 1.0
        }
      ]
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32,
    "default": {
      "balanced": [
        1344,
        768
      ]
    }
  },
  "constraints": {
    "aspectRatios": [
      "16:9",
      "9:16",
      "1:1"
    ],
    "maxDurationFrames": 288,
    "supportsSubtitles": true
  },
  "chain": {
    "source": "clip-latent",
    "sampleExtra": 22,
    "lengthGrid": [
      17,
      5
    ]
  }
}
