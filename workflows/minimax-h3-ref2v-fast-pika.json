{
  "id": "minimax-h3-ref2v-fast-pika",
  "version": 1,
  "capability": "video.reference2video",
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 参考生成视频（Pika 4 步 · fast）",
  "description": "r2v 的 Pika 适配器 4 步 fast 变体（832 长边 / lcm + 自拟 4 值 sigma / BlockSparseAttention sol-attn）。官方 Pika 只有 6 步 7 值 schedule，4 步属实验清单。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_MODEL_REF",
      "label": "H3 参考 UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "env": "DSH_SVS_H3_CLIP",
      "label": "H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_VAE",
      "label": "H3 视频 VAE（int8_convrot，Pika 官方模板配对）"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "env": "DSH_SVS_H3_AUDIO_VAE",
      "label": "H3 音频 VAE"
    },
    "lora_pika": {
      "kind": "lora",
      "default": "pika_h3_flex_ref2va_v1_bf16.safetensors",
      "env": "DSH_SVS_H3_LORA_PIKA",
      "label": "Pika H3 Flex 6 步适配器（ref2va, bf16, strength 1.0）"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "minimax"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "5": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "audio_vae": [
          "4a",
          0
        ],
        "prompt": null,
        "width": null,
        "height": null,
        "length": null,
        "ref_image_size": "match"
      }
    },
    "6": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": null
      }
    },
    "7": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "2b",
          0
        ],
        "conditioning": [
          "5",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "lcm"
      }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "14",
          0
        ],
        "latent_image": [
          "5",
          1
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "12": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "11",
          0
        ],
        "audio": [
          "11a",
          0
        ],
        "fps": null
      }
    },
    "13": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "12",
          0
        ],
        "filename_prefix": null,
        "format": "mp4",
        "codec": "h264"
      }
    },
    "14": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "1.0, 0.948025, 0.8, 0.452381, 0.0"
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    },
    "2b": {
      "class_type": "BlockSparseAttention",
      "inputs": {
        "model": [
          "$model",
          0
        ],
        "selection": "sol-attn",
        "selection.tau": 1,
        "start_percent": 0.2,
        "end_percent": 1,
        "dense_blocks": "",
        "min_tokens": 12288,
        "extra_tokens": 256,
        "sink_conditioning": "exact_kv_and_rows",
        "verbose": true
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "prompt"
      }
    },
    "width": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "width"
      }
    },
    "height": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "height"
      }
    },
    "length": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "length"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "noise_seed"
      }
    },
    "fps": {
      "inject": "scalar",
      "to": {
        "node": "12",
        "field": "fps"
      },
      "default": 24
    },
    "refs": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "ref_images.ref_image_${i}"
      },
      "max": 8
    },
    "ref_audios": {
      "inject": "audio",
      "via": "node",
      "node": "LoadAudio",
      "input": "audio",
      "to": {
        "node": "5",
        "field": "ref_audios.ref_audio_${i}"
      },
      "max": 3
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "13",
        "field": "filename_prefix"
      }
    }
  },
  "modes": {
    "fast": {
      "steps": 4,
      "longSide": 832,
      "loras": [
        {
          "asset": "lora_pika",
          "strength": 1
        }
      ]
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32,
    "default": {
      "fast": [
        832,
        480
      ]
    }
  },
  "constraints": {
    "aspectRatios": [
      "16:9",
      "9:16",
      "1:1"
    ],
    "maxDurationFrames": 310,
    "supportsSubtitles": true
  },
  "group": "minimax-h3-ref2v",
  "tier": "fast",
  "estSeconds": 20,
  "note": "r2v · Pika 4 步 fast（自拟 sigma [1.0, 0.948025, 0.8, 0.452381, 0.0]）+ BlockSparseAttention(sol-attn, tau 1.0)。实测整镜 ~20s（对照标准 fast 22.8s / Pika 6 步 @832 26.0s）。",
  "priority": -55
}
