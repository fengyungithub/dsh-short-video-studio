{
  "id": "minimax-h3-ref2v-ctx-balanced-pdd-2k",
  "version": 1,
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 参考视频·链式续接 + 学习式放大（>2K）（已弃用）",
  "description": "**已弃用，不要用于新镜头**：PDD 接在首遍（设计文档推荐接二遍），实测更慢且闪烁 +150%；改用 minimax-h3-ref2v-ctx-quality-pdd2-2k。 MiniMax H3 参考视频·链式续接 + 学习式放大（>2K） · balanced 档。由 scripts/make-h3-variants.mjs 生成，请勿手改。 两阶段：首遍尺寸**不锁**（按画布比例推导，本档长边 1344）→ 潜空间放大 ×2 → 交付 = 首遍 ×2。16:9 首遍 1344×756 → 交付 2688×1512；9:16 首遍 756×1344 → 交付 1512×2688；1:1 首遍 1344×1344 → 交付 2688×2688（像素量为 16:9 的 1.78×，更重）。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_MODEL_REF",
      "label": "H3 参考 UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "env": "DSH_SVS_H3_CLIP",
      "label": "H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_fp16.safetensors",
      "env": "DSH_SVS_H3_VAE",
      "label": "H3 视频 VAE"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "env": "DSH_SVS_H3_AUDIO_VAE",
      "label": "H3 音频 VAE"
    },
    "pdd": {
      "kind": "other",
      "default": "minimax_h3_ref2va_pdd_acc_8step_comfyui.safetensors",
      "env": "DSH_SVS_H3_PDD_REF2V",
      "label": "MiniMax-H3 Ref2VA PDD Acc 8 步（放 models/pdd_acc/）"
    },
    "latent_upscaler": {
      "kind": "other",
      "default": "minimax_h3_latent_upscaler_3d_conv_v1_bf16.safetensors",
      "env": "DSH_SVS_H3_LATENT_UPSCALER",
      "label": "H3 学习式 latent 放大器（3D）"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift_video": 12,
        "shift_audio": 3
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "minimax"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "5": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "audio_vae": [
          "4a",
          0
        ],
        "prompt": null,
        "width": null,
        "height": null,
        "length": null,
        "ref_image_size": "match"
      }
    },
    "6": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": null
      }
    },
    "7": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "2a",
          0
        ],
        "conditioning": [
          "21",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "2a",
          1
        ],
        "latent_image": [
          "5",
          1
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "12": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "23",
          0
        ],
        "audio": [
          "23",
          1
        ],
        "fps": null
      }
    },
    "13": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "12",
          0
        ],
        "filename_prefix": null,
        "format": "mp4",
        "codec": "h264"
      }
    },
    "17": {
      "class_type": "MinimaxH3LatentUpscaler3DRefineHandoff",
      "inputs": {
        "latent": [
          "10",
          0
        ],
        "noise": [
          "6b",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9b",
          0
        ],
        "model": [
          "2",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "model_name": "$assets.latent_upscaler",
        "mode": "target dimensions",
        "width": "${width * 2}",
        "height": "${height * 2}",
        "scale": 2,
        "megapixels": 1,
        "align": 32,
        "keep_proportion": true,
        "lock_audio": true,
        "cfg": 1,
        "device": "cuda",
        "precision": "bf16",
        "offload_after_upscale": true
      }
    },
    "20": {
      "class_type": "MiniMaxH3MotionContextLoadLatent",
      "inputs": {
        "latent_path": "h3_context",
        "clip_index": null
      }
    },
    "21": {
      "class_type": "MiniMaxH3MotionContext",
      "inputs": {
        "conditioning": [
          "5",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "latent": [
          "5",
          1
        ],
        "context_length": "22",
        "audio_context_length": 24,
        "context_latent": [
          "20",
          0
        ]
      }
    },
    "22": {
      "class_type": "MiniMaxH3MotionContextSaveLatent",
      "inputs": {
        "latent": [
          "10",
          0
        ],
        "filename_prefix": "h3_context/clip",
        "clip_index": null
      }
    },
    "23": {
      "class_type": "MiniMaxH3MotionContextTrim",
      "inputs": {
        "images": [
          "11b",
          0
        ],
        "trim_frames": [
          "21",
          1
        ],
        "audio": [
          "11c",
          0
        ],
        "fps": 24,
        "match_tail": true
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    },
    "2a": {
      "class_type": "MiniMaxH3PDDAccApply",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "pdd_file": "$assets.pdd",
        "nfe": "8",
        "lora_strength": 1,
        "head_strength": 1,
        "on_off_grid": "error",
        "partition": "",
        "enabled": true,
        "partition_check": "error"
      }
    },
    "6b": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "${seed + 2000000}"
      }
    },
    "9b": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 0.3
      }
    },
    "11b": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "17",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "11c": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "17",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "prompt"
      }
    },
    "width": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "width"
      }
    },
    "height": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "height"
      }
    },
    "length": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "length"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "noise_seed"
      }
    },
    "fps": {
      "inject": "scalar",
      "to": {
        "node": "12",
        "field": "fps"
      },
      "default": 24
    },
    "refs": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "ref_images.ref_image_${i}"
      },
      "max": 8
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "13",
        "field": "filename_prefix"
      }
    },
    "nfe": {
      "inject": "scalar",
      "to": {
        "node": "2a",
        "field": "nfe"
      },
      "default": "8"
    },
    "context_length": {
      "inject": "scalar",
      "to": {
        "node": "21",
        "field": "context_length"
      },
      "default": "22"
    },
    "audio_context_length": {
      "inject": "scalar",
      "to": {
        "node": "21",
        "field": "audio_context_length"
      },
      "default": 24
    },
    "context_clip_index": {
      "inject": "scalar",
      "to": {
        "node": "20",
        "field": "clip_index"
      }
    },
    "save_clip_index": {
      "inject": "scalar",
      "to": {
        "node": "22",
        "field": "clip_index"
      }
    },
    "steps2": {
      "inject": "scalar",
      "to": {
        "node": "9b",
        "field": "steps"
      },
      "default": 6
    }
  },
  "modes": {
    "balanced": {
      "steps": 8,
      "longSide": 1344
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32,
    "default": {
      "balanced": [
        1344,
        768
      ]
    }
  },
  "constraints": {
    "aspectRatios": [
      "16:9",
      "9:16",
      "1:1"
    ],
    "maxDurationFrames": 124,
    "supportsSubtitles": true
  },
  "group": "minimax-h3-ref2v-ctx-2k",
  "tier": "balanced",
  "requiresNodes": [
    "MiniMaxH3MotionContext",
    "MiniMaxH3MotionContextLoadLatent",
    "MiniMaxH3MotionContextSaveLatent",
    "MiniMaxH3MotionContextTrim",
    "MiniMaxH3PDDAccApply",
    "MinimaxH3LatentUpscaler3DRefineHandoff"
  ],
  "note": "**已弃用**：PDD 接在首遍（设计文档推荐接二遍），实测更慢且闪烁 +150%；改用 minimax-h3-ref2v-ctx-quality-pdd2-2k。 链式续接 + 学习式 latent ×2 · PDD 在**首遍**（nfe=8）· 交付 2688×1536",
  "chain": {
    "source": "clip-latent",
    "sampleExtra": 22,
    "lengthGrid": [
      17,
      5
    ]
  },
  "resolutionLock": {
    "scale": 2,
    "note": "两阶段放大：首遍尺寸**不锁**（按显式 width/height 或画布比例 × 档位长边推导），学习式 3D latent 放大器 ×2 推到首遍的 2 倍，再以低噪声（denoise 0.3）精修。交付尺寸 = 首遍 × 2（16:9 首遍 1344×768 → 交付 2688×1536）。链式续接：**链上流动的是首遍 latent**（node 22 存的是 node 10），放大在其之后 ⇒ 同族续接成立；一条链内**首遍尺寸必须一致**（跨比例续接不成立），交付尺寸可以不同。"
  },
  "capability": "video.reference2video",
  "estSeconds": 1200,
  "internal": true
}
