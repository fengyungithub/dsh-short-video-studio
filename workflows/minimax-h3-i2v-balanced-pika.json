{
  "id": "minimax-h3-i2v-balanced-pika",
  "version": 1,
  "capability": "video.image2video",
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 首末帧生成视频",
  "description": "MiniMax H3 首末帧生成视频 · balanced 档。由 scripts/make-h3-variants.mjs 生成，请勿手改。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_MODEL_FL",
      "label": "H3 FL2VA UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "env": "DSH_SVS_H3_CLIP",
      "label": "H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_int8_convrot.safetensors",
      "env": "DSH_SVS_H3_VAE",
      "label": "H3 视频 VAE（int8_convrot，Pika 官方模板配对）"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "env": "DSH_SVS_H3_AUDIO_VAE",
      "label": "H3 音频 VAE"
    },
    "lora_pika": {
      "kind": "lora",
      "default": "pika_h3_flex_fl2va_v1_bf16.safetensors",
      "env": "DSH_SVS_H3_LORA_FL_PIKA",
      "label": "Pika H3 Flex 6 步适配器（fl2va, bf16, strength 1.0）"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "minimax"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "5": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "prompt": null,
        "width": null,
        "height": null,
        "length": null
      }
    },
    "6": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": null
      }
    },
    "7": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "$model",
          0
        ],
        "conditioning": [
          "5",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "lcm"
      }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "14",
          0
        ],
        "latent_image": [
          "5",
          1
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "12": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "11",
          0
        ],
        "audio": [
          "11a",
          0
        ],
        "fps": null
      }
    },
    "13": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "12",
          0
        ],
        "filename_prefix": null,
        "format": "mp4",
        "codec": "h264"
      }
    },
    "14": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "1.0, 0.972973, 0.923077, 0.8, 0.571429, 0.333333, 0.0"
      }
    },
    "24": {
      "class_type": "OpenH3SaveRefinedLatent",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "frame_count": null,
        "filename_prefix": null,
        "audio": [
          "11a",
          0
        ]
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "prompt"
      }
    },
    "width": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "width"
      }
    },
    "height": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "height"
      }
    },
    "length": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "length"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "noise_seed"
      }
    },
    "fps": {
      "inject": "scalar",
      "to": {
        "node": "12",
        "field": "fps"
      },
      "default": 24
    },
    "first_frame": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "first_frame"
      },
      "preprocess": [
        {
          "class_type": "ImageScale",
          "inputs": {
            "upscale_method": "lanczos",
            "width": "${width}",
            "height": "${height}",
            "crop": "disabled"
          }
        }
      ]
    },
    "last_frame": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "last_frame"
      },
      "preprocess": [
        {
          "class_type": "ImageScale",
          "inputs": {
            "upscale_method": "lanczos",
            "width": "${width}",
            "height": "${height}",
            "crop": "disabled"
          }
        }
      ]
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "13",
        "field": "filename_prefix"
      }
    },
    "latent_prefix": {
      "inject": "scalar",
      "to": {
        "node": "24",
        "field": "filename_prefix"
      },
      "default": "h3_handoff"
    },
    "latent_frame_count": {
      "inject": "scalar",
      "to": {
        "node": "24",
        "field": "frame_count"
      },
      "default": 0
    }
  },
  "modes": {
    "balanced": {
      "steps": 6,
      "longSide": 1344,
      "loras": [
        {
          "asset": "lora_pika",
          "strength": 1
        }
      ]
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32,
    "default": {
      "balanced": [
        1344,
        768
      ]
    }
  },
  "constraints": {
    "aspectRatios": [
      "16:9",
      "9:16",
      "1:1"
    ],
    "maxDurationFrames": 310,
    "supportsSubtitles": true
  },
  "group": "minimax-h3-i2v",
  "tier": "balanced",
  "estSeconds": 132,
  "note": "Pika H3 Flex 6 步（FL2VA）· lcm + 固定 sigma · 实测 132.2s（对 8 步 173.6s 为 1.31×）",
  "priority": -40
}
